{
  "name": "dsh-fishhome",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "大肥鱼的家园：一间会跟着现实时间过日子的小屋。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "isometric",
    "virtual-pet",
    "pixel-art"
  ],
  "homepage": "https://github.com/suika1984/dsh-fishhome",
  "repository": {
    "type": "git",
    "url": "https://github.com/suika1984/dsh-fishhome.git"
  },
  "bugs": {
    "url": "https://github.com/suika1984/dsh-fishhome/issues"
  },
  "author": "suika1984",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "build.mjs",
    "src",
    "data",
    "docs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "packs/bigfish-adult"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node test/model.test.js && node test/host.test.js && node test/ui.test.js && node test/mount.test.js",
    "check": "node tools/check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  }
}
